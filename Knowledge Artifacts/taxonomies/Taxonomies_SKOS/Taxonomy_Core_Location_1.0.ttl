# SKOS taxonomy generated from Taxonomy_Core_Location_1.0.ttl. Scheme <https://ontologies.verizon.com/taxonomy-core-location/>.

<https://ontologies.verizon.com/taxonomy-core-location/>
  a skos:ConceptScheme ;
  skos:prefLabel "Taxonomy | Core | Location"@en ;
  dct:description "The location taxonomy is a hierarchical framework for organizing and classifying different types of locations for efficient management and analysis of location data across various applications. It distinguishes between geospatial locations defined by coordinates, logical locations based on network addresses or functional roles, and physical locations representing tangible spaces like buildings or rooms."@en ;
  dct:title "Taxonomy | Core | Location"@en ;
  <http://www.linkedmodel.org/1.2/schema/vaem#namespace> "https://ontologies.verizon.com/taxonomy-core-location/"^^<http://www.w3.org/2001/XMLSchema#anyURI> ;
  <http://open-services.net/ns/core#modifiedBy> "sherri.miller1@one.verizon.com" ;
  dct:contributor "milsh69", "wallkje", "sherri.miller1@one.verizon.com" ;
  dct:creator "Jeffrey Wallk", "Sherri Anderson" ;
  dct:modified "2025-09-30T19:47:04.122Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
  <http://purl.org/ontology/bibo/status> <http://purl.org/spar/pso/draft> ;
  skos:changeNote "This is the initial version of the core taxonomy to be refined over time with input from other stakeholders & resources." ;
  dct:created "2024-09-05T03:16:15.031Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
  owl:versionInfo "1.0" ;
  <http://verizon.ontologies.com/terms/certified> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
  skos:hasTopConcept tx:Location .

