<https://ontologies.verizon.com/taxonomy-reference-domain/>
  a skos:ConceptScheme ;
  skos:prefLabel "Taxonomy | Reference | Domain"@en ;
  dct:description "The domain reference taxonomy categorizes and organizes information related to business operations. It encompasses key domains such as commercial aspects, corporate structure, network infrastructure, and supply chain management, providing a comprehensive view of an organization’s operational landscape. This taxonomy facilitates data analysis, knowledge management, and decision-making by standardizing terminology and relationships between different business areas."@en ;
  dct:title "Taxonomy | Reference | Domain"@en ;
  <http://www.linkedmodel.org/1.2/schema/vaem#namespace> "https://ontologies.verizon.com/taxonomy-reference-domain/"^^<http://www.w3.org/2001/XMLSchema#anyURI> ;
  <http://open-services.net/ns/core#modifiedBy> "sherri.miller1@one.verizon.com" ;
  dct:contributor "milsh69", "wallkje", "sherri.miller1@one.verizon.com" ;
  dct:creator "Jeffrey Wallk", "Sherri Anderson" ;
  dct:modified "2025-09-30T19:49:12.946Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
  <http://purl.org/ontology/bibo/status> <http://purl.org/spar/pso/draft> ;
  skos:changeNote "This is the initial version of the reference taxonomy to be refined over time with input from other stakeholders & resources." ;
  dct:created "2024-09-15T06:15:42.901Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
  owl:versionInfo "1.0" ;
  <http://verizon.ontologies.com/terms/certified> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
