# SKOS taxonomy generated from Taxonomy_Core_Time_1.0.ttl. Scheme <https://ontologies.verizon.com/taxonomy-core-time/>.

<https://ontologies.verizon.com/taxonomy-core-time/>
  a skos:ConceptScheme ;
  skos:prefLabel "Taxonomy | Core | Time"@en ;
  dct:description "The time taxonomy categorizes our understanding of time into three distinct concepts. Absolute time refers to a fixed and universal timeline, often measured with units like seconds, minutes, and hours. In contrast, relative time describes the temporal relationships between events, such as “before,” “after,” or “during.” Lastly, episodic time focuses on our personal experiences and memories, which are inherently subjective and organized around significant events in our lives."@en ;
  dct:title "Taxonomy | Core | Time"@en ;
  <http://www.linkedmodel.org/1.2/schema/vaem#namespace> "https://ontologies.verizon.com/taxonomy-core-time/"^^<http://www.w3.org/2001/XMLSchema#anyURI> ;
  <http://open-services.net/ns/core#modifiedBy> "sherri.miller1@one.verizon.com" ;
  dct:contributor "milsh69", "wallkje", "sherri.miller1@one.verizon.com" ;
  dct:creator "Jeffrey Wallk", "Sherri Anderson" ;
  dct:modified "2025-09-30T19:48:43.948Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
  <http://purl.org/ontology/bibo/status> <http://purl.org/spar/pso/draft> ;
  skos:changeNote "This is the initial version of the core taxonomy to be refined over time with input from other stakeholders & resources." ;
  dct:created "2024-09-05T03:25:28.581Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
  owl:versionInfo "1.0" ;
  <http://verizon.ontologies.com/terms/certified> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
  skos:hasTopConcept tx:Time .

