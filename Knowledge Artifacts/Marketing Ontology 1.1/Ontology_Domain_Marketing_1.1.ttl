mkt:
  a owl:Ontology ;
  <http://purl.org/ontology/bibo/status> <http://purl.org/spar/pso/draft> ;
  <http://verizon.ontologies.com/terms/certified> false ;
  dct:contributor "milsh69", "sherri.miller1@one.verizon.com", "wallkje" ;
  dct:created "2024-09-27T18:40:00.503Z"^^xsd:dateTime ;
  dct:creator "Jeffrey Wallk", "Sherri Anderson" ;
  dct:description "The marketing domain ontology, built service-first on ontology-core-domain (the Domain Reference Model). It declares the marketing service catalog, the processes that enable each service and the capability each service enables, and the SHACL shapes that say what each process creates, uses, changes, targets or promotes. The terms those shapes point to are declared in taxonomy-domain-marketing and taxonomy-domain-marketing-ci."@en ;
  dct:language "en" ;
  dct:modified "2026-10-05T21:00:00.000Z"^^xsd:dateTime ;
  dct:title "Ontology | Domain | Marketing"@en ;
  owl:imports <http://purl.obolibrary.org/obo/ro/core.owl>, <https://ontologies.verizon.com/ontology-core-bundle/>, bo:, cap:, drm:, mkci:, mktx:, party:, persona:, proc:, svc:, vs: ;
  owl:priorVersion <https://ontologies.verizon.com/ontology-domain-marketing/1.0> ;
  owl:versionIRI <https://ontologies.verizon.com/ontology-domain-marketing/1.1> ;
  owl:versionInfo "1.1" ;
  rdfs:label "Ontology | Domain | Marketing"@en ;
  sh:declare [
        sh:namespace "http://purl.obolibrary.org/obo/"^^xsd:anyURI ;
        sh:prefix "obo"
      ], [
        sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ;
        sh:prefix "rdfs"
      ], [
        sh:namespace "https://ontologies.verizon.com/bfo-relations/"^^xsd:anyURI ;
        sh:prefix "vzro"
      ], [
        sh:namespace "https://ontologies.verizon.com/taxonomy-domain-marketing-ci/"^^xsd:anyURI ;
        sh:prefix "ci"
      ] ;
  skos:changeNote "1.1: classes that are not processes (for example Brand Equity, Customer Loyalty, Marketing Plans) moved to taxonomy-domain-marketing; their 1.0 IRIs remain here as deprecated equivalent classes."@en, "1.1: competitive intelligence services, processes and terms were surfaced from the PEO Competitive Graph."@en, "1.1: every core parent resolves to a class declared in the core: ontology-core-domain, ontology-core-asset, -capability, -event and -requirements, and the core taxonomies (taxonomy-core-*). The ontology imports each core taxonomy and ontology it uses directly, so the parent vocabularies, taxonomies and ontologies flow through."@en, "1.1: imports the Domain Reference Model 1.1 in place of the retired upper ontology; Lifecycle and Product Catalog are no longer subclasses of marketing processes."@en, "1.1: rebuilt service-first: 23 marketing services, each enabled by its processes and enabling a capability; 121 processes, each tied by a shape to the terms it creates, uses, changes, targets or promotes."@en ;
  skos:editorialNote "Construction order: services, then the processes that enable them, then the terms each process needs. Terms live in the two marketing taxonomies and are grounded in the two marketing vocabularies."@en, "Verizon Knowledge Engineering acknowledges that subject area matter content contained within this ontology was created with the assistance of VZGPT (vzgpt.verizon.com)."@en, "Version 1.1 content not carried over from 1.0 (the service catalog, the processes added in 1.1, the taxonomy terms and their definitions, and the competitive intelligence layer) was drafted with the assistance of Claude (Anthropic) from the 1.0 files, the Domain Reference Model and the PEO Competitive Graph. It requires steward review before certification."@en ;
  skos:historyNote "American marketing association | ama. (n.d.). American Marketing Association. Retrieved March 24, 2025, from https://www.ama.org/", "Barbu, E. (2006, December 14). An Ontology-based System for the Marketing Information Management. International workshop Formal Ontologies Meet Industry, Trento-Italy. https://pdfs.semanticscholar.org/380d/eed2304a68761c487872f03029643c07bc", "Kotler, P., & Keller, K. L. (2015). Marketing management (15. ed). Pearson." .

