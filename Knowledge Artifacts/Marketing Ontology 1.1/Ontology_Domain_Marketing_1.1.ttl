mkt:x_PartnerIncentiveRuleGuidesShape
  a sh:NodeShape ;
  sh:property [
        sh:class mkt:BrokerAdvisorMarketing ;
        sh:path drm:guides
      ] ;
  sh:targetClass mktx:PartnerIncentiveRule .

mkt:x_PricingModelGuidesShape
  a sh:NodeShape ;
  sh:property [
        sh:or ( [
              sh:class mkt:CompetitivePricingAnalysis
            ] [
              sh:class mkt:PriceSetting
            ] ) ;
        sh:path drm:guides
      ] ;
  sh:targetClass mktx:PricingModel .
