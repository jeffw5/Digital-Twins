  skos:scopeNote "Supports: Marketing Communications Service."@en .

mkt:AdvertisingShape
  a sh:NodeShape ;
  rdfs:comment "What Advertising creates, uses, changes, targets or promotes. These are the terms that emerge from the process."@en ;
  sh:property [
        sh:class mktx:Advertisement ;
        sh:path drm:creates
      ], [
        sh:class mktx:MediaChannel ;
        sh:path vzro:distributedThrough
      ] ;
  sh:targetClass mkt:Advertising .

mkt:AffiliateMarketing
