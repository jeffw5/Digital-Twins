mkt:AccountBasedMarketing
  a owl:Class ;
  dc11:subject <https://vocabularies.verizon.com/domain-marketing/1b83a6b3-58f2-4ade-b0fb-5fac94e31508> ;
  dct:created "2026-10-05T21:00:00.000Z"^^xsd:dateTime ;
  dct:creator "wallkje" ;
  dct:modified "2026-10-05T21:00:00.000Z"^^xsd:dateTime ;
  rdfs:isDefinedBy mkt: ;
  rdfs:label "Account-Based Marketing"@en ;
  rdfs:subClassOf mkt:Marketing ;
  skos:scopeNote "Supports: Account-Based Marketing Service."@en .

mkt:AccountBasedMarketingCapability
  a owl:Class ;
  dc11:subject <https://vocabularies.verizon.com/domain-marketing/1b83a6b3-58f2-4ade-b0fb-5fac94e31508> ;
  dct:created "2026-10-05T21:00:00.000Z"^^xsd:dateTime ;
  dct:creator "wallkje" ;
  dct:modified "2026-10-05T21:00:00.000Z"^^xsd:dateTime ;
  rdfs:isDefinedBy mkt: ;
  rdfs:label "Account-Based Marketing Capability"@en ;
  rdfs:subClassOf mkt:MarketingCapability ;
  skos:definition "The organization's ability to deliver the Account-Based Marketing Service; realized in its enabling processes."@en .

mkt:AccountBasedMarketingCapabilityShape
  a sh:NodeShape ;
  rdfs:comment "Polymorphism pivot: the capability is realized in the processes that enable its service."@en ;
  sh:property [
        sh:class mkt:AccountBasedMarketing ;
        sh:path obo:BFO_0000054
      ] ;
  sh:targetClass mkt:AccountBasedMarketingCapability .

mkt:AccountBasedMarketingService
  a owl:Class ;
  dc11:subject <https://vocabularies.verizon.com/domain-marketing/1b83a6b3-58f2-4ade-b0fb-5fac94e31508> ;
  dct:created "2026-10-05T21:00:00.000Z"^^xsd:dateTime ;
  dct:creator "wallkje" ;
  dct:modified "2026-10-05T21:00:00.000Z"^^xsd:dateTime ;
  rdfs:isDefinedBy mkt: ;
  rdfs:label "Account-Based Marketing Service"@en ;
  rdfs:subClassOf mkt:MarketingService ;
  skos:definition "The service that selects target accounts and coordinates personalized marketing to win them."@en .

mkt:AccountBasedMarketingServiceShape
  a sh:NodeShape ;
  rdfs:comment "The Account-Based Marketing Service is enabled by its supporting processes and enables the matching capability."@en ;
  sh:property [
        sh:class mkt:AccountBasedMarketing ;
        sh:minCount 1 ;
        sh:path drm:enabledBy
      ], [
        sh:class mkt:AccountBasedMarketingCapability ;
        sh:path drm:enables
      ] ;
  sh:targetClass mkt:AccountBasedMarketingService .

mkt:AccountSelectionPrioritization
  a owl:Class ;
  dc11:subject <https://vocabularies.verizon.com/domain-marketing/5dbd9937-d0d8-4406-8f7c-7d2d1058f41f> ;
  dct:created "2026-10-05T21:00:00.000Z"^^xsd:dateTime ;
  dct:creator "wallkje" ;
  dct:modified "2026-10-05T21:00:00.000Z"^^xsd:dateTime ;
  rdfs:isDefinedBy mkt: ;
  rdfs:label "Account Selection & Prioritization"@en ;
  rdfs:subClassOf mkt:AccountBasedMarketing ;
  skos:scopeNote "Supports: Account-Based Marketing Service."@en .

mkt:AccountSelectionPrioritizationShape
  a sh:NodeShape ;
  rdfs:comment "What Account Selection & Prioritization creates, uses, changes, targets or promotes. These are the terms that emerge from the process."@en ;
  sh:property [
        sh:class mktx:TargetAccountList ;
        sh:path drm:creates
      ], [
        sh:class mktx:TargetAccountRole ;
        sh:path vzro:targets
      ] ;
  sh:targetClass mkt:AccountSelectionPrioritization .

mkt:Advertising
  a owl:Class ;
  dc11:subject <https://vocabularies.verizon.com/domain-marketing/1130172d-2f85-456e-bb67-af913cf701e7> ;
