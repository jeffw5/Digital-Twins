mkt:BattlecardCapability
  a owl:Class ;
  dc11:subject <https://vocabularies.verizon.com/domain-marketing-ci/b25f4325-3b6d-5ff8-8374-ab897b1e081e> ;
  dct:created "2026-10-05T21:00:00.000Z"^^xsd:dateTime ;
  dct:creator "wallkje" ;
  dct:modified "2026-10-05T21:00:00.000Z"^^xsd:dateTime ;
  rdfs:isDefinedBy mkt: ;
  rdfs:label "Battlecard Capability"@en ;
  rdfs:subClassOf mkt:CompetitiveIntelligenceCapability ;
  skos:definition "The organization's ability to deliver the Battlecard Service; realized in its enabling processes."@en .

mkt:BattlecardCapabilityShape
  a sh:NodeShape ;
  rdfs:comment "Polymorphism pivot: the capability is realized in the processes that enable its service."@en ;
  sh:property [
        sh:class mkt:BattlecardPublishing ;
        sh:path obo:BFO_0000054
      ] ;
  sh:targetClass mkt:BattlecardCapability .

mkt:BattlecardPublishing
  a owl:Class ;
  dc11:subject <https://vocabularies.verizon.com/domain-marketing-ci/b25f4325-3b6d-5ff8-8374-ab897b1e081e> ;
  dct:created "2026-10-05T21:00:00.000Z"^^xsd:dateTime ;
  dct:creator "wallkje" ;
  dct:modified "2026-10-05T21:00:00.000Z"^^xsd:dateTime ;
  rdfs:isDefinedBy mkt: ;
  rdfs:label "Battlecard Publishing"@en ;
  rdfs:subClassOf mkt:CompetitiveIntelligence ;
  skos:scopeNote "Supports: Battlecard Service, Competitive Intelligence Service, Market Research & Insights Service."@en .

mkt:BattlecardPublishingShape
  a sh:NodeShape ;
  rdfs:comment "What Battlecard Publishing creates, uses, changes, targets or promotes. These are the terms that emerge from the process."@en ;
  sh:property [
        sh:class mkci:ReleasableVerdict ;
        sh:path drm:consumes
      ], [
        sh:or ( [
              sh:class mkci:Battlecard
            ] [
              sh:class mkci:ClaimLedger
            ] ) ;
        sh:path drm:creates
      ] ;
  sh:targetClass mkt:BattlecardPublishing .

mkt:BattlecardService
  a owl:Class ;
  dc11:subject <https://vocabularies.verizon.com/domain-marketing-ci/b25f4325-3b6d-5ff8-8374-ab897b1e081e> ;
  dct:created "2026-10-05T21:00:00.000Z"^^xsd:dateTime ;
  dct:creator "wallkje" ;
  dct:modified "2026-10-05T21:00:00.000Z"^^xsd:dateTime ;
  rdfs:isDefinedBy mkt: ;
  rdfs:label "Battlecard Service"@en ;
  rdfs:subClassOf mkt:CompetitiveIntelligenceService ;
  skos:definition "The service that publishes sales-facing battlecards built only from claims that cleared verification."@en .

mkt:BattlecardServiceShape
  a sh:NodeShape ;
  rdfs:comment "The Battlecard Service is enabled by its supporting processes and enables the matching capability."@en ;
  sh:property [
        sh:class mkt:BattlecardCapability ;
        sh:path drm:enables
      ], [
        sh:class mkt:BattlecardPublishing ;
        sh:minCount 1 ;
        sh:path drm:enabledBy
      ] ;
  sh:targetClass mkt:BattlecardService .

mkt:BattlecardShape
  a sh:NodeShape ;
  rdfs:comment "A battlecard may contain only claims whose current verdict is releasable."@en ;
  sh:property [
        sh:class mktx:MarketClaim ;
        sh:path obo:BFO_0000051
      ] ;
  sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Contains a claim without a current releasable verdict."@en ;
        sh:prefixes mkt: ;
        sh:select "SELECT $this ?value WHERE {\n  $this obo:BFO_0000051 ?value .\n  FILTER NOT EXISTS {\n    ?v obo:IAO_0000136 ?value ; a/rdfs:subClassOf* ci:ReleasableVerdict .\n    FILTER NOT EXISTS { ?newer vzro:supersedes ?v }\n  }\n}"
      ] ;
  sh:targetClass mkci:Battlecard .

