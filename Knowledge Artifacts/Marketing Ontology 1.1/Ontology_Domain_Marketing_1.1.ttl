mkt:ThreatAssessmentShape
  a sh:NodeShape ;
  rdfs:comment "A threat names what it weakens, how badly, and the sources behind it."@en ;
  sh:property [
        sh:class mkci:IntelligenceSource ;
        sh:minCount 1 ;
        sh:path vzro:evidencedBy
      ], [
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:maxInclusive 3 ;
        sh:minCount 1 ;
        sh:minInclusive 1 ;
        sh:path mkci:severityScore
      ], [
        sh:minCount 1 ;
        sh:or ( [
              sh:class cap:Capability
            ] [
              sh:class mktx:MarketSegment
            ] [
              sh:class mktx:PositioningClaim
            ] ) ;
        sh:path obo:IAO_0000136
      ] ;
  sh:targetClass mkci:ThreatAssessment .

