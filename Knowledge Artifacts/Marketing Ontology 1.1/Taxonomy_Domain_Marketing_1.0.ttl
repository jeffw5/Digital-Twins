mktx:
  a owl:Ontology ;
  <http://purl.org/ontology/bibo/status> <http://purl.org/spar/pso/draft> ;
  <http://verizon.ontologies.com/terms/certified> false ;
  dct:contributor "wallkje" ;
  dct:created "2026-10-05T21:00:00.000Z"^^xsd:dateTime ;
  dct:creator "Jeffrey Wallk", "Sherri Anderson" ;
  dct:description "Term structures that emerge from the marketing processes: plans, content, brand assets, claims, data, metrics, offerings and features, market roles, segments, rules, channels, characteristics, market events, lifecycle stages, personas, issues and outcomes. Each root specialises a Domain Reference Model root."@en ;
  dct:language "en" ;
  dct:modified "2026-10-05T21:00:00.000Z"^^xsd:dateTime ;
  dct:title "Taxonomy | Domain | Marketing"@en ;
  owl:imports <https://ontologies.verizon.com/ontology-core-domain/>, asset:, bo:, evt:, issue:, lc:, persona:, req:, role:, rules: ;
  owl:versionIRI <https://ontologies.verizon.com/taxonomy-domain-marketing/1.0> ;
  owl:versionInfo "1.0" ;
  rdfs:label "Taxonomy | Domain | Marketing"@en ;
  skos:changeNote "1.0: every root specialises a class declared in the core taxonomies and ontologies, which this taxonomy imports: for example Marketing Outcome specialises Outcome (ontology-core-requirements), Marketing Strategy specialises Strategy and Marketing Technology specialises Technology (taxonomy-core-businessoperations)."@en, "1.0: initial version, built from the terms the marketing processes create, use, change, target or promote."@en ;
  skos:editorialNote "Version 1.1 content not carried over from 1.0 (the service catalog, the processes added in 1.1, the taxonomy terms and their definitions, and the competitive intelligence layer) was drafted with the assistance of Claude (Anthropic) from the 1.0 files, the Domain Reference Model and the PEO Competitive Graph. It requires steward review before certification."@en .

