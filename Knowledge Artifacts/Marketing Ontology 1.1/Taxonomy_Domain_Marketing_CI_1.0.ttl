mkci:
  a owl:Ontology ;
  <http://purl.org/ontology/bibo/status> <http://purl.org/spar/pso/draft> ;
  <http://verizon.ontologies.com/terms/certified> false ;
  dct:contributor "wallkje" ;
  dct:created "2026-10-05T21:00:00.000Z"^^xsd:dateTime ;
  dct:creator "Jeffrey Wallk", "Sherri Anderson" ;
  dct:description "Term structures for competitive intelligence, surfaced from the PEO Competitive Graph: the market holon, intelligence sources by authority tier, competitor claims, claim checks and verdicts, verification results, threat and opening assessments, roll-up scores, MTBH, intelligence products, competitive moves and PEO credentials."@en ;
  dct:language "en" ;
  dct:modified "2026-10-05T21:00:00.000Z"^^xsd:dateTime ;
  dct:title "Taxonomy | Domain | Marketing | Competitive Intelligence"@en ;
  owl:imports <https://ontologies.verizon.com/ontology-core-domain/>, mktx: ;
  owl:versionIRI <https://ontologies.verizon.com/taxonomy-domain-marketing-ci/1.0> ;
  owl:versionInfo "1.0" ;
  rdfs:label "Taxonomy | Domain | Marketing | Competitive Intelligence"@en ;
  skos:changeNote "1.0: initial version. Every class was surfaced from the PEO Competitive Graph and cites it as dct:source."@en ;
  skos:editorialNote "Version 1.1 content not carried over from 1.0 (the service catalog, the processes added in 1.1, the taxonomy terms and their definitions, and the competitive intelligence layer) was drafted with the assistance of Claude (Anthropic) from the 1.0 files, the Domain Reference Model and the PEO Competitive Graph. It requires steward review before certification."@en .

