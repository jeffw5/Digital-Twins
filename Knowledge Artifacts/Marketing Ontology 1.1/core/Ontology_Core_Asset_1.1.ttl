<https://ontologies.verizon.com/ontology-core-asset/> a owl:Ontology;
  rdfs:label "Ontology | Core | Asset"@en;
  dct:title "Ontology | Core | Asset"@en;
  dct:description "This ontology defines the core concept of an asset, including its attributes and relationships. This is foundational for managing and tracking assets within the organization."@en;
  owl:versionIRI <https://ontologies.verizon.com/ontology-core-asset/1.1>;
  owl:versionInfo "1.1";
  owl:priorVersion <https://ontologies.verizon.com/ontology-core-asset/1.0>;
  dct:creator "Jeffrey Wallk", "Sherri Anderson";
  dct:contributor "milsh69", "wallkje", "sherri.miller1@one.verizon.com";
  dct:created "2024-09-24T15:52:20.458Z"^^xsd:dateTime;
  dct:modified "2026-10-05T16:00:00.000Z"^^xsd:dateTime;
  <http://purl.org/ontology/bibo/status> <http://purl.org/spar/pso/draft>;
  <http://verizon.ontologies.com/terms/certified> false;
  skos:changeNote "v1.1: SystemEngineering now points to its own core-asset vocabulary concept, System Engineering (b5f33aea-30d7-4585-b1e2-b074d1126cec), instead of sharing SolutionArchitecture's; imports the party, persona, lifecycle and valuestream taxonomies that its subclass axioms and shapes already reference.";
  owl:imports <https://ontologies.verizon.com/ontology-core-domain/>,
    <https://ontologies.verizon.com/taxonomy-core-product/>,
    <https://ontologies.verizon.com/taxonomy-core-party/>,
    <https://ontologies.verizon.com/taxonomy-core-persona/>,
    <https://ontologies.verizon.com/taxonomy-core-lifecycle/>,
    <https://ontologies.verizon.com/taxonomy-core-valuestream/>;
  skos:changeNote "v1.1 (DRM): the separate upper ontology is retired. Its relations are declared in the Domain Reference Model (ontology-core-domain), which this module now imports as its foundation; shape paths use the ontology-core-domain relation IRIs."@en .

