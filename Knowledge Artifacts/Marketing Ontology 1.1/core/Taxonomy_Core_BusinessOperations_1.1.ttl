busi:
  a owl:Ontology ;
  dct:creator "Jeffrey Wallk" ;
  dct:description "The OWL class rendering of vocabulary-core-businessoperations: one class per concept, rdfs:subClassOf following skos:broader, each class grounded in its concept by dc:subject. Its root, Business Operations, is equivalent to Business Operations in taxonomy-core-services (core mappings: skos:exactMatch)."@en ;
  dct:modified "2026-10-06T00:00:00.000Z"^^xsd:dateTime ;
  dct:source <https://vocabularies.verizon.com/core-businessoperations> ;
  dct:title "Taxonomy | Core | Business Operations"@en ;
  owl:imports <https://ontologies.verizon.com/ontology-core-domain/>, <https://ontologies.verizon.com/taxonomy-core-services/> ;
  owl:versionIRI <https://ontologies.verizon.com/taxonomy-core-businessoperations/1.1> ;
  owl:versionInfo "1.1" ;
  rdfs:label "Taxonomy | Core | Business Operations"@en ;
  skos:changeNote "1.1: generated from the core vocabulary so the class IRIs that ontology-core-domain and the core ontologies already use (for example AnalyticsReporting, ArtificialIntelligence, Benchmarking) resolve to declared classes."@en .

