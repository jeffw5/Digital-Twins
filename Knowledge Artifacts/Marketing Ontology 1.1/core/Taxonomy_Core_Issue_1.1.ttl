issu:Request
  a owl:Class ;
  dc11:subject <https://vocabularies.verizon.com/core-issue/e9cee37a-9a70-43d7-a1d6-2a125bddae63> ;
  rdfs:isDefinedBy issu: ;
  rdfs:label "Request"@en ;
  rdfs:subClassOf issu:Issue .
