<https://ontologies.verizon.com/ontology-core-capability/> a owl:Ontology;
  rdfs:label "Ontology | Core | Capability"@en;
  dct:title "Ontology | Core | Capability"@en;
  dct:description "This ontology defines the core concept of a capability, including its attributes and relationships. This is foundational for understanding and analyzing the organization's capabilities."@en;
  owl:versionIRI <https://ontologies.verizon.com/ontology-core-capability/1.1>;
  owl:versionInfo "1.1";
  owl:priorVersion <https://ontologies.verizon.com/ontology-core-capability/1.0>;
  dct:creator "Jeffrey Wallk", "Sherri Anderson";
  dct:contributor "milsh69", "wallkje", "sherri.miller1@one.verizon.com";
  dct:created "2024-09-15T00:00:00.000Z"^^xsd:dateTime;
  dct:modified "2026-10-05T16:00:00.000Z"^^xsd:dateTime;
  <http://purl.org/ontology/bibo/status> <http://purl.org/spar/pso/draft>;
  <http://verizon.ontologies.com/terms/certified> false;
  skos:changeNote "v1.1: removed embedded TM Forum SID individuals, RAN network attributes and ThinkHome energy terms; moved the 2012 service model, co-ode governance personas and DQM properties to vocabulary-core-servicemodel (imported); dropped orphaned anonymous datatypes, misspelled skos declarations and local file: IRIs.";
  owl:imports <https://ontologies.verizon.com/ontology-core-domain/>,
    <https://ontologies.verizon.com/vocabulary-core-servicemodel/>;
  skos:changeNote "v1.1 (DRM): the separate upper ontology is retired. Its relations are declared in the Domain Reference Model (ontology-core-domain), which this module now imports as its foundation; shape paths use the ontology-core-domain relation IRIs."@en .

