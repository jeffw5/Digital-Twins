<https://ontologies.verizon.com/ontology-core-requirements/JobExecutorShape> a sh:NodeShape;
  sh:property [
      sh:path drm:performs;
      sh:class <https://ontologies.verizon.com/ontology-core-requirements/Job>
    ], [
      sh:path drm:enables;
      sh:class <https://ontologies.verizon.com/ontology-core-requirements/Outcome>
    ], [
      sh:path drm:hasRelated;
      sh:class <https://ontologies.verizon.com/taxonomy-core-persona/Persona>
    ];
  sh:targetClass <https://ontologies.verizon.com/ontology-core-requirements/JobExecutor> .

<https://ontologies.verizon.com/ontology-core-requirements/JobShape> a sh:NodeShape;
  sh:property [
      sh:path drm:is;
      sh:class <https://ontologies.verizon.com/ontology-core-requirements/Journey>
    ];
  sh:targetClass <https://ontologies.verizon.com/ontology-core-requirements/Job> .

<https://ontologies.verizon.com/ontology-core-requirements/JobStepShape> a sh:NodeShape;
  sh:property [
      sh:path drm:is;
      sh:class <https://ontologies.verizon.com/ontology-core-requirements/JourneyStep>
    ], [
      sh:path drm:provides;
      sh:class <https://ontologies.verizon.com/ontology-core-requirements/Outcome>
    ];
  sh:targetClass <https://ontologies.verizon.com/ontology-core-requirements/JobStep> .

