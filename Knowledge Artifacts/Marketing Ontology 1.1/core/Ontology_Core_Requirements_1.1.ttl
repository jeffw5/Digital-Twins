<https://ontologies.verizon.com/ontology-core-requirements/> a owl:Ontology;
  rdfs:label "Ontology | Core | Requirements"@en;
  dct:title "Ontology | Core | Requirements"@en;
  dct:description "This ontology defines the core concept of requirements, including their attributes, relationships, and how they drive the development of products or services."@en;
  owl:versionIRI <https://ontologies.verizon.com/ontology-core-requirements/1.1>;
  owl:versionInfo "1.1";
  owl:priorVersion <https://ontologies.verizon.com/ontology-core-requirements/1.0>;
  dct:creator "Jeffrey Wallk", "Sherri Anderson";
  dct:contributor "milsh69", "wallkje", "sherri.miller1@one.verizon.com";
  dct:created "2024-09-15T18:09:54.500Z"^^xsd:dateTime;
  dct:modified "2026-10-05T16:00:00.000Z"^^xsd:dateTime;
  <http://purl.org/ontology/bibo/status> <http://purl.org/spar/pso/draft>;
  <http://verizon.ontologies.com/terms/certified> false;
  skos:changeNote "v1.1: removed seven reflexive subClassOf axioms; NonFunctionalFeature is now a subclass of Feature and disjoint with FunctionalFeature; shapes moved from metaphacts paths to upper-ontology paths; duplicate metaphacts Persona constraint on JobExecutor removed. Now imported by ontology-core-domain.";
  owl:imports <https://ontologies.verizon.com/ontology-core-domain/>,
    <https://ontologies.verizon.com/taxonomy-core-persona/>;
  skos:changeNote "v1.1 (DRM): the separate upper ontology is retired. Its relations are declared in the Domain Reference Model (ontology-core-domain), which this module now imports as its foundation; shape paths use the ontology-core-domain relation IRIs."@en .

