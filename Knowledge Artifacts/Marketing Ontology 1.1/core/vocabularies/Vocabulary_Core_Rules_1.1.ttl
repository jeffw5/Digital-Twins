<https://vocabularies.verizon.com/core-rules/bbb126d7-188f-4605-8c80-3c86a6c9c044>
  a skos:Concept;
  skos:definition "Process based rules that test conditions and upon finding them true, initiate another business event, message or other activity"@en;
  skos:example "IF <condition> THEN action"@en;
  skos:prefLabel "Action Enabler Rule"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-rules>;
  skos:broader <https://vocabularies.verizon.com/core-rules/010f06d3-b29c-422f-8383-e2d63c6a2832>;
