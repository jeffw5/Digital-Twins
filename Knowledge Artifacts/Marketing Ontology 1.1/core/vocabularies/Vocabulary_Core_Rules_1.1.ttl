<https://vocabularies.verizon.com/core-rules/e5cb3a2a-5ad5-4830-9982-d136e55798c6>
  a skos:Concept;
  skos:definition "Rule that does not reject the transaction; they merely warn about an undesirable circumstance. Usually translates to warning messages."@en;
  skos:example "<term> SHOULD HAVE <at least, at most, exactly n of> <term>"@en, "<term> SHOULD BE IN LIST <a,b,c>"@en;
  skos:prefLabel "Guideline"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-rules>;
  skos:broader <https://vocabularies.verizon.com/core-rules/010f06d3-b29c-422f-8383-e2d63c6a2832>;
