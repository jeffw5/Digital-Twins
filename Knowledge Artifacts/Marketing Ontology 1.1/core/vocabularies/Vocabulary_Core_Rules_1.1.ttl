<https://vocabularies.verizon.com/core-rules/dcfed8cd-9779-4e12-9c72-5179ea71dee8>
  a skos:Concept;
  skos:definition "Specify that if certain facts are true, a particular conclusion can be determined."@en;
  skos:example "IF <term> <operator> <term> THEN <term> <operator> <term>"@en;
  skos:prefLabel "Inference Rule"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-rules>;
  skos:broader <https://vocabularies.verizon.com/core-rules/7eddaa82-f972-4884-99e8-52312de04b8f>;
