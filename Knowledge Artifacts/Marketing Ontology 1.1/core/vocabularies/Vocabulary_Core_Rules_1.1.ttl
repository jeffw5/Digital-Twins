<https://vocabularies.verizon.com/core-rules/178a3efb-9f2f-48b4-bc32-6e95f242db1d>
  a skos:Concept;
  skos:definition "Rules used for validation of data"@en;
  skos:prefLabel "Constraint Rule"@en;
