<https://vocabularies.verizon.com/core-rules/1071b57a-5253-45bc-8974-35415e92e356>
  a skos:Concept;
  skos:definition "Rules that reject the attempted business transaction"@en;
  skos:example "<term> MUST HAVE <at least, at most, exactly n of> <term>"@en, "<term> MUST BE IN LIST <a,b,c>"@en;
  skos:scopeNote "Grammar to use during rule documentation not implementation."@en;
  skos:prefLabel "Mandatory Constraint"@en;
