<https://vocabularies.verizon.com/core-businessoperations/574a1bd9-d70b-4ae9-81f9-8aa3ea18284a>
  a skos:Concept;
  skos:definition "Minimizing or eliminating the unnecessary use of resources."@en;
  skos:prefLabel "Waste Reduction"@en;
