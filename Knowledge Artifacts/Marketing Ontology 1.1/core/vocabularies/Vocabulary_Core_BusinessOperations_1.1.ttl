<https://vocabularies.verizon.com/core-businessoperations/09e149aa-70de-49a5-91c6-844da1118196>
  a skos:Concept;
  skos:definition "Meeting the needs of the present without compromising the ability of future generations to meet their own needs."@en;
  skos:prefLabel "Sustainability"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-businessoperations>;
