  dct:modified "2025-04-01T20:32:47.054Z"^^xsd:dateTime;
  dct:created "2025-04-01T20:31:38.318Z"^^xsd:dateTime .

<https://vocabularies.verizon.com/core-businessoperations/c98faac9-06c5-41c8-9c60-3aa6e2ae4d2d>
  a skos:Concept;
  skos:definition "This describes the types of relationships a company establishes with its customer segments. This could range from personal and hands-on to automated and self-service. Examples include personal assistance, dedicated account managers, self-service portals, and automated email communication."@en;
  skos:prefLabel "Customer Relationships"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-businessoperations>;
  skos:broader <https://vocabularies.verizon.com/core-businessoperations/4c4cdf34-f512-4815-84f6-715dbc5ff3b8>;
