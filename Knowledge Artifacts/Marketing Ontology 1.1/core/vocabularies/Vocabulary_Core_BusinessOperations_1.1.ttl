  dct:modified "2025-04-01T20:32:55.353Z"^^xsd:dateTime;
  dct:created "2025-04-01T20:31:38.318Z"^^xsd:dateTime .

<https://vocabularies.verizon.com/core-businessoperations/4ce27546-1e58-453b-ab28-f5b76ddddec8>
  a skos:Concept;
  skos:definition "Customer segmentation involves dividing a company’s target market into distinct groups based on shared characteristics like demographics, behaviors, needs, and wants. This allows for more targeted marketing and product development."@en;
  skos:prefLabel "Customer Segmentation"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-businessoperations>;
  skos:broader <https://vocabularies.verizon.com/core-businessoperations/4c4cdf34-f512-4815-84f6-715dbc5ff3b8>;
  <http://open-services.net/ns/core#modifiedBy> "milsh69";
