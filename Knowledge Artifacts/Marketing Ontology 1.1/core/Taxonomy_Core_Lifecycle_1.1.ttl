life:
  a owl:Ontology ;
  dct:creator "Jeffrey Wallk" ;
  dct:description "The OWL class rendering of vocabulary-core-lifecycle: one class per concept, rdfs:subClassOf following skos:broader, each class grounded in its concept by dc:subject. Its root, Lifecycle, is the root class ontology-core-domain declares; this taxonomy adds the classes beneath it."@en ;
  dct:modified "2026-10-06T00:00:00.000Z"^^xsd:dateTime ;
  dct:source <https://vocabularies.verizon.com/core-lifecycle> ;
  dct:title "Taxonomy | Core | Lifecycle"@en ;
  owl:imports <https://ontologies.verizon.com/ontology-core-domain/> ;
  owl:versionIRI <https://ontologies.verizon.com/taxonomy-core-lifecycle/1.1> ;
  owl:versionInfo "1.1" ;
  rdfs:label "Taxonomy | Core | Lifecycle"@en ;
  skos:changeNote "1.1: generated from the core vocabulary so the class IRIs that ontology-core-domain and the core ontologies already use (for example Acquire, Build, Buy) resolve to declared classes."@en .

