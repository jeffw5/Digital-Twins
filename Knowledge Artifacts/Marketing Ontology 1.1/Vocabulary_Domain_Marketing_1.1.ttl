<https://vocabularies.verizon.com/domain-marketing>
  a skos:ConceptScheme ;
  <http://purl.org/ontology/bibo/status> <http://purl.org/spar/pso/draft> ;
  <http://verizon.ontologies.com/terms/certified> false ;
  <http://www.linkedmodel.org/1.2/schema/vaem#namespace> <https://vocabularies.verizon.com/domain-marketing/> ;
  dct:contributor "milsh69" ;
  dct:created "2025-03-25T17:02:58.984Z"^^xsd:dateTime ;
  dct:creator "wallkje" ;
  dct:description "Concepts for the marketing domain: the marketing services, the processes that enable them, and the terms those processes create, use, target or measure."@en ;
  dct:language "en" ;
  dct:modified "2026-10-05T21:00:00.000Z"^^xsd:dateTime ;
  dct:title "Vocabulary | Domain | Marketing"@en ;
  owl:versionInfo "1.1" ;
  rdfs:label "Vocabulary | Domain | Marketing"@en ;
  skos:changeNote "1.1: rebuilt service-first. Concepts follow the service catalog in ontology-domain-marketing 1.1, its enabling processes, and the terms those processes create, use, target or measure. Each term concept has a scope note naming the processes it emerges from and the services they support."@en, "1.1: the 81 concepts of 1.0 keep their IRIs and definitions. Competitive intelligence concepts are in vocabulary-domain-marketing-ci."@en, "1.1: the top concept Marketing is skos:exactMatch to Marketing in vocabulary-core-domain, so this scheme inherits from the core vocabulary."@en ;
  skos:editorialNote "Verizon Knowledge Engineering acknowledges that some definitions contained within this vocabulary were generated with the assistance of VZGPT (vzgpt.verizon.com) or Google Gemini."@en, "Version 1.1 content not carried over from 1.0 (the service catalog, the processes added in 1.1, the taxonomy terms and their definitions, and the competitive intelligence layer) was drafted with the assistance of Claude (Anthropic) from the 1.0 files, the Domain Reference Model and the PEO Competitive Graph. It requires steward review before certification."@en ;
  skos:hasTopConcept <https://vocabularies.verizon.com/domain-marketing/747cff66-c9c1-4e4f-a756-c5d0d4dc25ff> ;
  skos:prefLabel "Vocabulary | Domain | Marketing"@en .

