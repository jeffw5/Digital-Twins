<https://ontologies.verizon.com/ontology-core-domain/OutcomeBridgeShape> a sh:NodeShape;
  rdfs:comment "Binds Requirements to the operating model: every Outcome is enabled by a Capability."@en;
  sh:targetClass <https://ontologies.verizon.com/ontology-core-requirements/Outcome>;
  sh:property [ sh:path drm:enabledBy; sh:class <https://ontologies.verizon.com/ontology-core-capability/Capability> ] .

<https://ontologies.verizon.com/ontology-core-domain/JobStepBridgeShape> a sh:NodeShape;
  rdfs:comment "Binds Requirements to the operating model: a Job Step is performed through a Process."@en;
  sh:targetClass <https://ontologies.verizon.com/ontology-core-requirements/JobStep>;
  sh:property [ sh:path drm:performedBy; sh:class <https://ontologies.verizon.com/taxonomy-core-process/Process> ] .

<https://ontologies.verizon.com/ontology-core-domain/FeatureBridgeShape> a sh:NodeShape;
  rdfs:comment "Binds Requirements to the operating model: a Feature is delivered by a Service."@en;
  sh:targetClass <https://ontologies.verizon.com/ontology-core-requirements/Feature>;
  sh:property [ sh:path drm:enabledBy; sh:class <https://ontologies.verizon.com/taxonomy-core-services/Services> ] .

# ---------------------------------------------------------------- shared relations (formerly the upper ontology)

drm:enables a owl:ObjectProperty;
  rdfs:label "enables"@en;
  skos:definition "The subject makes the object possible or supports it; for example an Asset enables a Process and Services enable a Capability."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/enables>;
  owl:inverseOf drm:enabledBy .

drm:enabledBy a owl:ObjectProperty;
  rdfs:label "enabled by"@en;
  skos:definition "Inverse of enables."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/enabledBy>;
  owl:inverseOf drm:enables .

drm:performs a owl:ObjectProperty;
  rdfs:label "performs"@en;
  skos:definition "An agent, persona or role carries out a process."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/performs>;
  owl:inverseOf drm:performedBy;
  rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000056> .

drm:performedBy a owl:ObjectProperty;
  rdfs:label "performed by"@en;
  skos:definition "A process is carried out by the object."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/performedBy>;
  owl:inverseOf drm:performs;
  rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000057> .

drm:occursIn a owl:ObjectProperty;
  rdfs:label "occurs in"@en;
  skos:definition "An event or issue takes place in a location or within a process."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/occursIn>;
  skos:closeMatch <http://purl.obolibrary.org/obo/BFO_0000066> .

drm:occursWhen a owl:ObjectProperty;
  rdfs:label "occurs when"@en;
  skos:definition "An event takes place at, or during, a time."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/occursWhen> .

drm:assignedTo a owl:ObjectProperty;
  rdfs:label "assigned to"@en;
  skos:definition "A persona or party is given a role."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/assignedTo>;
  skos:closeMatch <http://purl.obolibrary.org/obo/RO_0000087> .

drm:guides a owl:ObjectProperty;
  rdfs:label "guides"@en;
  skos:definition "A rule or standard informs how a process should be carried out without strictly binding it."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/guides> .

drm:constrains a owl:ObjectProperty;
  rdfs:label "constrains"@en;
  skos:definition "A rule limits how a process may be carried out."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/constrains> .

drm:controls a owl:ObjectProperty;
  rdfs:label "controls"@en;
  skos:definition "A compliance requirement or control governs a process."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/controls> .

drm:generates a owl:ObjectProperty;
  rdfs:label "generates"@en;
  skos:definition "The subject gives rise to the object; for example an Event generates a Process and a Process generates an Observation."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/generates> .

drm:creates a owl:ObjectProperty;
  rdfs:label "creates"@en;
  skos:definition "A process brings an asset into existence."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/creates> .

drm:modifies a owl:ObjectProperty;
  rdfs:label "modifies"@en;
  skos:definition "A process changes an asset."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/modifies> .

drm:consumes a owl:ObjectProperty;
  rdfs:label "consumes"@en;
  skos:definition "A role or process uses up, or uses the output of, a process or asset."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/consumes> .

drm:typeOf a owl:ObjectProperty;
  rdfs:label "type of"@en;
  skos:definition "The subject is a kind or category associated with the object."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/typeOf> .

drm:has a owl:ObjectProperty;
  rdfs:label "has"@en;
  skos:definition "General has-part or has-characteristic relation; for example Services have a Lifecycle and an Event has an Event State."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/has>;
  skos:closeMatch <http://purl.obolibrary.org/obo/BFO_0000051> .

drm:hasRelated a owl:ObjectProperty;
  rdfs:label "has related"@en;
  skos:definition "General association between two entities where no more specific relation applies."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/hasRelated> .

drm:is a owl:ObjectProperty;
  rdfs:label "is"@en;
  skos:definition "General identity or classification statement used by Requirements shapes; prefer a more specific relation where one exists."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/is> .

drm:provides a owl:ObjectProperty;
  rdfs:label "provides"@en;
  skos:definition "The subject supplies the object; for example a Job Executor provides an Outcome."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/provides> .

drm:initiates a owl:ObjectProperty;
  rdfs:label "initiates"@en;
  skos:definition "A trigger starts an event."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/initiates>;
  owl:inverseOf drm:initiatedBy .

drm:initiatedBy a owl:ObjectProperty;
  rdfs:label "initiated by"@en;
  skos:definition "An event is started by a trigger."@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  dct:replaces <https://ontologies.verizon.com/upperontology/initiatedBy>;
  owl:inverseOf drm:initiates .

