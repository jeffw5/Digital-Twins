@prefix drm: <https://ontologies.verizon.com/ontology-core-domain/> .

<https://ontologies.verizon.com/ontology-core-domain/> a owl:Ontology;
  rdfs:label "Ontology | Core | Domain Reference Model"@en;
  dct:title "Ontology | Core | Domain Reference Model"@en;
  dct:description "The Domain Reference Model (DRM) is Verizon's unifying ontology and the foundation for every other domain ontology. It declares the shared relations, the root classes each domain ontology specialises, and the SHACL rules that bind them, and it anchors all of these to BFO 2020 through the OBO Relations Core. Core, taxonomy and governance ontologies import the DRM; the DRM imports only RO core and BFO."@en;
  owl:versionIRI <https://ontologies.verizon.com/ontology-core-domain/1.1>;
  owl:versionInfo "1.1";
  owl:priorVersion <https://ontologies.verizon.com/ontology-core-domain/1.0>;
  dct:creator "Jeffrey Wallk", "Sherri Anderson";
  dct:contributor "milsh69", "wallkje", "sherri.miller1@one.verizon.com";
  dct:created "2024-10-02T01:04:45.186Z"^^xsd:dateTime;
  dct:modified "2026-10-05T16:00:00.000Z"^^xsd:dateTime;
  <http://purl.org/ontology/bibo/status> <http://purl.org/spar/pso/draft>;
  <http://verizon.ontologies.com/terms/certified> false;
  skos:changeNote "v1.1: imports ontology-core-requirements and alignment-upper-ro; removed the 13 metaphacts-namespace shapes and stubs that duplicated the verizon shapes; Event shape now lives in ontology-core-event (occursWhen); Services has a Lifecycle; run-time service classes re-homed to taxonomy-core-services; added Outcome, JobStep and Feature bridge shapes.", "v1.1 (vocabularies): OperationsManagement, Communications and ServiceLevelManagement now carry dc11:subject links to their core-services concepts; Reporting and Training have no core-services concept yet.",
    "v1.1 (DRM): renamed Domain Reference Model and made the foundation. The separate upper ontology and the upper-to-RO alignment module are retired: their 21 relations, RO alignments and BFO anchors are declared here. The DRM no longer imports the core, taxonomy and governance modules; they import it. upperontology IRIs remain as deprecated owl:equivalentProperty for existing data. Event, not Events, is anchored to occurrent, because Events also groups Event State and Trigger."@en;
  owl:imports <http://purl.obolibrary.org/obo/ro/core.owl>, <http://purl.obolibrary.org/obo/bfo/2020/bfo.owl> .

<https://ontologies.verizon.com/ontology-core-domain/Domain> a owl:Class;
  rdfs:label "Domain"@en;
  rdfs:isDefinedBy <https://ontologies.verizon.com/ontology-core-domain/>;
  <http://open-services.net/ns/core#modifiedBy> "milsh69";
  dct:contributor "milsh69", "wallkje";
  dct:creator "wallkje";
  dct:modified "2025-04-17T13:44:19.495Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>;
  dct:created "2024-10-02T01:08:09.624Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>;
  <http://purl.org/dc/elements/1.1/subject> <https://vocabularies.verizon.com/core-domain/cbbdf6cc-4d02-4205-85e5-1eadbf014603> .

<https://ontologies.verizon.com/taxonomy-core-compliance/ComplianceShape> a sh:NodeShape;
  sh:property [
      sh:path drm:controls;
      sh:class <https://ontologies.verizon.com/taxonomy-core-process/Process>
    ];
  sh:targetClass <https://ontologies.verizon.com/taxonomy-core-compliance/Compliance> .

<https://ontologies.verizon.com/taxonomy-core-persona/PersonaShape> a sh:NodeShape;
  sh:property [
      sh:path drm:assignedTo;
      sh:class <https://ontologies.verizon.com/taxonomy-core-role/Role>
    ], [
      sh:path drm:performs;
      sh:class <https://ontologies.verizon.com/taxonomy-core-process/Process>
    ];
  sh:targetClass <https://ontologies.verizon.com/taxonomy-core-persona/Persona> .

<https://ontologies.verizon.com/ontology-core-asset/DigitalAssetShape> a sh:NodeShape;
  sh:property [
      sh:path drm:enables;
      sh:class <https://ontologies.verizon.com/taxonomy-core-process/Process>
    ];
  sh:targetClass <https://ontologies.verizon.com/ontology-core-asset/DigitalAsset> .

<https://ontologies.verizon.com/ontology-core-asset/PhysicalAssetShape> a sh:NodeShape;
  sh:property [
      sh:path drm:enables;
      sh:class <https://ontologies.verizon.com/taxonomy-core-process/Process>
    ];
  sh:targetClass <https://ontologies.verizon.com/ontology-core-asset/PhysicalAsset> .

<https://ontologies.verizon.com/taxonomy-core-issue/IssueShape> a sh:NodeShape;
  sh:property [
      sh:path drm:occursIn;
      sh:class <https://ontologies.verizon.com/taxonomy-core-process/Process>
    ], [
      sh:path drm:generates;
      sh:class <https://ontologies.verizon.com/taxonomy-core-process/Observation>
    ];
  sh:targetClass <https://ontologies.verizon.com/taxonomy-core-issue/Issue> .

<https://ontologies.verizon.com/taxonomy-core-process/ProcessShape> a sh:NodeShape;
  sh:property [
      sh:path drm:generates;
      sh:class <https://ontologies.verizon.com/taxonomy-core-process/Observation>
    ], [
      sh:path drm:creates;
      sh:class <https://ontologies.verizon.com/ontology-core-asset/DigitalAsset>
    ], [
      sh:path drm:modifies;
      sh:class <https://ontologies.verizon.com/ontology-core-asset/DigitalAsset>
    ], [
      sh:path drm:creates;
      sh:class <https://ontologies.verizon.com/ontology-core-asset/PhysicalAsset>
    ], [
      sh:path drm:performedBy;
      sh:class <https://ontologies.verizon.com/taxonomy-core-persona/Persona>
    ], [
      sh:path drm:modifies;
      sh:class <https://ontologies.verizon.com/ontology-core-asset/PhysicalAsset>
    ], [
      sh:path drm:typeOf;
      sh:class <https://ontologies.verizon.com/ontology-core-asset/DigitalAsset>
    ], [
      sh:path drm:enables;
      sh:class <https://ontologies.verizon.com/taxonomy-core-services/Services>
    ], [
      sh:path drm:occursIn;
      sh:class <https://ontologies.verizon.com/taxonomy-core-location/Location>
    ];
  sh:targetClass <https://ontologies.verizon.com/taxonomy-core-process/Process> .

<https://ontologies.verizon.com/taxonomy-core-role/RoleShape> a sh:NodeShape;
  sh:property [
      sh:path drm:performs;
      sh:class <https://ontologies.verizon.com/taxonomy-core-process/Process>
    ], [
      sh:path drm:consumes;
      sh:class <https://ontologies.verizon.com/taxonomy-core-process/Process>
    ];
  sh:targetClass <https://ontologies.verizon.com/taxonomy-core-role/Role> .

<https://ontologies.verizon.com/taxonomy-core-rules/RulesShape> a sh:NodeShape;
  sh:property [
      sh:path drm:guides;
      sh:class <https://ontologies.verizon.com/taxonomy-core-process/Process>
    ], [
      sh:path drm:constrains;
      sh:class <https://ontologies.verizon.com/taxonomy-core-process/Process>
    ];
  sh:targetClass <https://ontologies.verizon.com/taxonomy-core-rules/Rules> .

<https://ontologies.verizon.com/taxonomy-core-services/ServicesShape> a sh:NodeShape;
  sh:property [
      sh:path drm:enables;
      sh:class <https://ontologies.verizon.com/ontology-core-capability/Capability>
    ], [
      sh:path drm:enables;
      sh:class <https://ontologies.verizon.com/taxonomy-core-valuestream/ValueStream>
    ], [
      sh:path drm:assignedTo;
      sh:class <https://ontologies.verizon.com/taxonomy-core-persona/Persona>
    ], [
      sh:path drm:has;
      sh:class <https://ontologies.verizon.com/taxonomy-core-lifecycle/Lifecycle>
    ];
  sh:targetClass <https://ontologies.verizon.com/taxonomy-core-services/Services> .

<https://ontologies.verizon.com/taxonomy-core-valuestream/ValueStreamShape> a sh:NodeShape;
  sh:property [
      sh:path drm:enabledBy;
      sh:class <https://ontologies.verizon.com/taxonomy-core-services/Services>
    ];
  sh:targetClass <https://ontologies.verizon.com/taxonomy-core-valuestream/ValueStream> .

