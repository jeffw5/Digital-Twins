# Vocabulary | Core | Service Model 1.1 - with class hierarchy derived from the legacy service-model IRI paths.

<https://ontologies.verizon.com/vocabulary-core-servicemodel/>
  a owl:Ontology ;
  rdfs:label "Vocabulary | Core | Service Model"@en ;
  dct:title "Vocabulary | Core | Service Model"@en ;
  dct:description "Inherited vocabulary from the 2012 service model (lifecycle artifacts, personas, outcomes, governance controls, tools, applications), co-ode governance personas and DQM data-quality rule properties. Extracted from ontology-core-capability and ontology-core-event v1.0, where it was duplicated."@en ;
  owl:versionIRI <https://ontologies.verizon.com/vocabulary-core-servicemodel/1.1> ;
  owl:versionInfo "1.1" ;
  dct:creator "Jeffrey Wallk" ;
  dct:created "2012-10-01T00:00:00.000Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
  dct:modified "2026-10-05T12:00:00.000Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> ;
  dct:source <http://www.semanticweb.org/jeffrey/ontologies/2012/9/service.model>, <http://purl.org/dqm-vocabulary/v1/dqm> ;
  <http://purl.org/ontology/bibo/status> <http://purl.org/spar/pso/draft> .

