@base <https://www.enablingvalue.com/ontology-core-governance-data#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dg: <https://www.enablingvalue.com/ontology-core-governance-data#> .

### Ontology
<https://www.enablingvalue.com/ontology-core-governance-data>
    rdf:type owl:Ontology ;
    owl:imports <https://ontologies.verizon.com/ontology-core-domain/> ,
        <https://ontologies.verizon.com/ontology-core-asset/> ;
    owl:versionIRI <https://www.enablingvalue.com/ontology-core-governance-data/1.1> ;
    owl:versionInfo "1.1" ;
    rdfs:label "Data Governance Ontology"@en ;
    rdfs:comment "Models enterprise data governance including assets, policies, roles, and quality."@en .

### -------------------------------------------------------
### Classes
### -------------------------------------------------------

dg:DataAsset
    rdf:type owl:Class ;
    rdfs:label "Data Asset"@en ;
    rdfs:comment "A governed data resource — structured, semi-structured, or unstructured — subject to classification and quality management."@en .

dg:StructuredDataAsset
    rdf:type owl:Class ;
    rdfs:subClassOf dg:DataAsset ;
    rdfs:label "Structured Data Asset"@en ;
    rdfs:comment "A data asset with a defined schema such as a relational table or structured file."@en .

dg:UnstructuredDataAsset
    rdf:type owl:Class ;
    rdfs:subClassOf dg:DataAsset ;
    rdfs:label "Unstructured Data Asset"@en ;
    rdfs:comment "A data asset without a predefined schema, such as documents or images."@en .

dg:SemiStructuredDataAsset
    rdf:type owl:Class ;
    rdfs:subClassOf dg:DataAsset ;
    rdfs:label "Semi-Structured Data Asset"@en ;
    rdfs:comment "A data asset with partial structure such as JSON or XML."@en .

dg:DataPolicy
    rdf:type owl:Class ;
    rdfs:label "Data Policy"@en ;
    rdfs:comment "A formal directive specifying rules for accessing, storing, retaining, or disposing of data assets."@en .

dg:AccessPolicy
    rdf:type owl:Class ;
    rdfs:subClassOf dg:DataPolicy ;
    rdfs:label "Access Policy"@en ;
    rdfs:comment "A policy that governs who may access a data asset and under what conditions."@en .

dg:RetentionPolicy
    rdf:type owl:Class ;
    rdfs:subClassOf dg:DataPolicy ;
    rdfs:label "Retention Policy"@en ;
    rdfs:comment "A policy specifying mandatory retention periods before a data asset may be disposed of."@en .

dg:QualityPolicy
    rdf:type owl:Class ;
    rdfs:subClassOf dg:DataPolicy ;
    rdfs:label "Quality Policy"@en ;
    rdfs:comment "A policy specifying minimum quality thresholds a data asset must satisfy to be fit for use."@en .

dg:PrivacyPolicy
    rdf:type owl:Class ;
    rdfs:subClassOf dg:DataPolicy ;
    rdfs:label "Privacy Policy"@en ;
    rdfs:comment "A policy governing handling of personally identifiable information in compliance with applicable regulations."@en .

dg:GovernanceBody
    rdf:type owl:Class ;
    rdfs:label "Governance Body"@en ;
    rdfs:comment "An organizational unit with authority to establish and enforce data governance standards."@en .

dg:DataGovernanceCouncil
    rdf:type owl:Class ;
    rdfs:subClassOf dg:GovernanceBody ;
    rdfs:label "Data Governance Council"@en ;
    rdfs:comment "A senior cross-functional body that sets enterprise-wide data policy and defines governance charters."@en .

dg:DomainGovernanceBoard
    rdf:type owl:Class ;
    rdfs:subClassOf dg:GovernanceBody ;
    rdfs:label "Domain Governance Board"@en ;
    rdfs:comment "A domain-level body that applies enterprise policy within a specific business or data domain."@en .

dg:GovernanceRole
    rdf:type owl:Class ;
    rdfs:label "Governance Role"@en ;
    rdfs:comment "An accountable organizational role within a data governance program."@en .

dg:DataOwner
    rdf:type owl:Class ;
    rdfs:subClassOf dg:GovernanceRole ;
    rdfs:label "Data Owner"@en ;
    rdfs:comment "A role accountable for data quality and policy compliance within a business function."@en .

dg:DataSteward
    rdf:type owl:Class ;
    rdfs:subClassOf dg:GovernanceRole ;
    rdfs:label "Data Steward"@en ;
    rdfs:comment "A role responsible for daily governance execution within specific data domains."@en .

dg:DataCustodian
    rdf:type owl:Class ;
    rdfs:subClassOf dg:GovernanceRole ;
    rdfs:label "Data Custodian"@en ;
    rdfs:comment "A technical role responsible for safe storage, transport, and protection of data assets."@en .

dg:DataQualityDimension
    rdf:type owl:Class ;
    rdfs:label "Data Quality Dimension"@en ;
    rdfs:comment "A measurable attribute of data quality applied to evaluate a data asset."@en .

dg:AccuracyDimension
    rdf:type owl:Class ;
    rdfs:subClassOf dg:DataQualityDimension ;
    rdfs:label "Accuracy Dimension"@en ;
    rdfs:comment "Measures the degree to which data correctly represents the real-world entity it describes."@en .

dg:CompletenessDimension
    rdf:type owl:Class ;
    rdfs:subClassOf dg:DataQualityDimension ;
    rdfs:label "Completeness Dimension"@en ;
    rdfs:comment "Measures the proportion of required data values that are present and non-null."@en .

dg:ConsistencyDimension
    rdf:type owl:Class ;
    rdfs:subClassOf dg:DataQualityDimension ;
    rdfs:label "Consistency Dimension"@en ;
    rdfs:comment "Measures the absence of contradictions across related data assets or representations."@en .

dg:TimelinessDimension
    rdf:type owl:Class ;
    rdfs:subClassOf dg:DataQualityDimension ;
    rdfs:label "Timeliness Dimension"@en ;
    rdfs:comment "Measures the degree to which data is current and available when needed."@en .

### -------------------------------------------------------
### Object Properties
### -------------------------------------------------------

dg:governs
    rdf:type owl:ObjectProperty ;
    rdfs:label "governs"@en ;
    rdfs:domain dg:DataPolicy ;
    rdfs:range dg:DataAsset ;
    rdfs:comment "Relates a data policy to the data asset it governs."@en .

dg:setsPolicy
    rdf:type owl:ObjectProperty ;
    rdfs:label "sets policy"@en ;
    rdfs:domain dg:GovernanceBody ;
    rdfs:range dg:DataPolicy ;
    rdfs:comment "Relates a governance body to the policies it establishes."@en .

dg:managesAsset
    rdf:type owl:ObjectProperty ;
    rdfs:label "manages asset"@en ;
    rdfs:domain dg:DataSteward ;
    rdfs:range dg:DataAsset ;
    rdfs:comment "Relates a data steward to the data asset they manage."@en .

dg:ownedBy
    rdf:type owl:ObjectProperty ;
    rdfs:label "owned by"@en ;
    rdfs:domain dg:DataAsset ;
    rdfs:range dg:DataOwner ;
    rdfs:comment "Relates a data asset to its accountable owner."@en .

dg:custodiedBy
    rdf:type owl:ObjectProperty ;
    rdfs:label "custodied by"@en ;
    rdfs:domain dg:DataAsset ;
    rdfs:range dg:DataCustodian ;
    rdfs:comment "Relates a data asset to the custodian responsible for its physical storage and protection."@en .

dg:hasQualityDimension
    rdf:type owl:ObjectProperty ;
    rdfs:label "has quality dimension"@en ;
    rdfs:domain dg:DataAsset ;
    rdfs:range dg:DataQualityDimension ;
    rdfs:comment "Relates a data asset to the quality dimensions by which it is evaluated."@en .

dg:enforcedBy
    rdf:type owl:ObjectProperty ;
    rdfs:label "enforced by"@en ;
    rdfs:domain dg:DataPolicy ;
    rdfs:range dg:GovernanceRole ;
    rdfs:comment "Relates a policy to the governance role responsible for its enforcement."@en .

### -------------------------------------------------------
### Datatype Properties
### -------------------------------------------------------

dg:hasClassification
    rdf:type owl:DatatypeProperty ;
    rdfs:label "has classification"@en ;
    rdfs:domain dg:DataAsset ;
    rdfs:range xsd:string ;
    rdfs:comment "Classification label applied to a data asset (e.g., Public, Confidential, Restricted)."@en .

dg:hasRetentionPeriod
    rdf:type owl:DatatypeProperty ;
    rdfs:label "has retention period"@en ;
    rdfs:domain dg:RetentionPolicy ;
    rdfs:range xsd:duration ;
    rdfs:comment "Mandatory duration for which a data asset must be retained before disposal."@en .

dg:hasDimensionScore
    rdf:type owl:DatatypeProperty ;
    rdfs:label "has dimension score"@en ;
    rdfs:domain dg:DataQualityDimension ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Numeric score (0.0–1.0) measuring a data quality dimension for a given asset."@en .

dg:hasAssetDescription
    rdf:type owl:DatatypeProperty ;
    rdfs:label "has asset description"@en ;
    rdfs:domain dg:DataAsset ;
    rdfs:range xsd:string ;
    rdfs:comment "Human-readable description of the data asset's content, purpose, and lineage."@en .

### -------------------------------------------------------
### Anchors to the Verizon core (v1.1)
### -------------------------------------------------------

dg:DataAsset rdfs:subClassOf <https://ontologies.verizon.com/ontology-core-asset/Data> .
dg:GovernanceRole rdfs:subClassOf <https://ontologies.verizon.com/taxonomy-core-role/Role> .
