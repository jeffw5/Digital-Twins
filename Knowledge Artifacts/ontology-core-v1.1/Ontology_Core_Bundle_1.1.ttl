@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ontologies.verizon.com/ontology-core-bundle/> a owl:Ontology;
  rdfs:label "Ontology | Core | Load Bundle"@en;
  dct:description "Load manifest only, with no axioms of its own. Importing it brings in the Domain Reference Model and every ontology built on it, which is what SHACL validation of the DRM's rules needs."@en;
  owl:versionIRI <https://ontologies.verizon.com/ontology-core-bundle/1.1>;
  owl:versionInfo "1.1";
  dct:created "2026-10-05T16:00:00.000Z"^^xsd:dateTime;
  owl:imports <https://ontologies.verizon.com/ontology-core-domain/>,
    <http://purl.obolibrary.org/obo/ro/core.owl>,
    <http://purl.obolibrary.org/obo/bfo/2020/bfo.owl>,
    <https://ontologies.verizon.com/ontology-core-asset/>,
    <https://ontologies.verizon.com/ontology-core-capability/>,
    <https://ontologies.verizon.com/ontology-core-event/>,
    <https://ontologies.verizon.com/ontology-core-requirements/>,
    <https://ontologies.verizon.com/vocabulary-core-servicemodel/>,
    <https://ontologies.verizon.com/taxonomy-core-product/>,
    <https://ontologies.verizon.com/taxonomy-core-party/>,
    <https://ontologies.verizon.com/taxonomy-core-persona/>,
    <https://ontologies.verizon.com/taxonomy-core-location/>,
    <https://ontologies.verizon.com/taxonomy-core-time/>,
    <https://ontologies.verizon.com/taxonomy-core-lifecycle/>,
    <https://ontologies.verizon.com/taxonomy-core-valuestream/>,
    <https://ontologies.verizon.com/taxonomy-core-process/>,
    <https://ontologies.verizon.com/taxonomy-core-services/>,
    <https://ontologies.verizon.com/taxonomy-core-services-technicalservices/>,
    <https://ontologies.verizon.com/taxonomy-core-role/>,
    <https://ontologies.verizon.com/taxonomy-core-rules/>,
    <https://ontologies.verizon.com/taxonomy-core-compliance/>,
    <https://ontologies.verizon.com/taxonomy-core-issue/>,
    <https://www.enablingvalue.com/ontology-core-governance-data>,
    <https://www.enablingvalue.com/ontology-core-governance-semantic>,
    <https://www.enablingvalue.com/ontology-core-governance-analytics>,
    <https://www.enablingvalue.com/ontology-core-governance-ai>,
