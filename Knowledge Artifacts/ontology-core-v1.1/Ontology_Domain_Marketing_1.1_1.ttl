  skos:definition "The date a change, such as a new price, takes effect."@en .

mkt:observedOn
  a owl:DatatypeProperty ;
  rdfs:isDefinedBy mkt: ;
  rdfs:label "observed on"@en ;
  rdfs:range xsd:date ;
  skos:definition "The date a source reported a market event or a signal was captured."@en .

mkt:severityScore
  a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:isDefinedBy mkt: ;
  rdfs:label "severity score"@en ;
  rdfs:range xsd:integer ;
  skos:definition "How seriously a threat weakens what it threatens: 1 low, 2 medium, 3 high."@en .

# ---------------------------------------------------------------------- SHACL shapes

mkt:AccountBasedMarketingCapabilityShape
