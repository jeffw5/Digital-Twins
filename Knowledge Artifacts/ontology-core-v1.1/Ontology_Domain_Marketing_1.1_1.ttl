mkt:CreatesOpeningForShape
  a sh:NodeShape ;
  sh:property [
        sh:or ( [
              sh:class cap:Capability
            ] [
              sh:class mkt:MarketSegment
            ] [
              sh:class mkt:PositioningClaim
            ] [
              sh:class mkt:Offering
            ] ) ;
        sh:path vzro:createsOpeningFor
      ] ;
  sh:targetSubjectsOf vzro:createsOpeningFor .

mkt:CustomerEngagementCapabilityShape
  a sh:NodeShape ;
  rdfs:comment "Polymorphism pivot: the Customer Engagement capability is realized in Customer Engagement processes."@en ;
  sh:property [
