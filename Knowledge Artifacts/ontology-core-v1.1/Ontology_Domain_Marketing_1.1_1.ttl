mkt:InfluencerMarketingCapabilityShape
  a sh:NodeShape ;
  rdfs:comment "Polymorphism pivot: the Influencer Marketing capability is realized in Influencer Marketing processes."@en ;
  sh:property [
        sh:class mkt:InfluencerMarketing ;
        sh:path obo:BFO_0000054
      ] ;
  sh:targetClass mkt:InfluencerMarketingCapability .

mkt:InfluencerMarketingServiceShape
  a sh:NodeShape ;
  rdfs:comment "Polymorphism pivot: the Influencer Marketing service enables the Influencer Marketing capability."@en ;
  sh:property [
        sh:class mkt:InfluencerMarketingCapability ;
        sh:path drm:enables
      ] ;
  sh:targetClass mkt:InfluencerMarketingService .

mkt:IntelligencePolicyShape
  a sh:NodeShape ;
  sh:property [
        sh:class mkt:CompetitiveIntelligence ;
        sh:path drm:constrains
      ] ;
  sh:targetClass mkt:IntelligencePolicy .

mkt:IntelligenceProductShape
  a sh:NodeShape ;
  rdfs:comment "An intelligence product may contain only claims whose current verdict is releasable."@en ;
  sh:property [
        sh:class mkt:MarketClaim ;
        sh:path obo:BFO_0000051
      ] ;
  sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Contains a claim without a current releasable verdict."@en ;
        sh:prefixes mkt: ;
        sh:select "SELECT $this ?value WHERE {\n  $this obo:BFO_0000051 ?value .\n  ?value a/rdfs:subClassOf* mkt:MarketClaim .\n  FILTER NOT EXISTS {\n    ?v obo:IAO_0000136 ?value ; a/rdfs:subClassOf* mkt:ReleasableVerdict .\n    FILTER NOT EXISTS { ?newer vzro:supersedes ?v }\n  }\n}"
      ] ;
  sh:targetClass mkt:IntelligenceProduct .

mkt:IntelligenceSignalShape
  a sh:NodeShape ;
  rdfs:comment "Every signal is about a market event, cites at least one source and carries the date it was observed."@en ;
  sh:property [
        sh:class mkt:IntelligenceSource ;
        sh:minCount 1 ;
        sh:path vzro:evidencedBy
      ], [
        sh:class mkt:MarketEvent ;
        sh:minCount 1 ;
        sh:path obo:IAO_0000136
      ], [
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:path mkt:observedOn
      ] ;
  sh:targetClass mkt:IntelligenceSignal .

mkt:IntelligenceVerificationShape
  a sh:NodeShape ;
  sh:property [
        sh:class mkt:ClaimVerificationVerdict ;
        sh:path drm:creates
      ], [
        sh:or ( [
              sh:class mkt:MarketClaim
            ] [
              sh:class mkt:IntelligenceSignal
            ] ) ;
        sh:path drm:consumes
      ] ;
  sh:targetClass mkt:IntelligenceVerification .

mkt:MarketClaimShape
  a sh:NodeShape ;
  sh:property [
        sh:class mkt:IntelligenceSource ;
        sh:minCount 1 ;
        sh:path vzro:evidencedBy
      ], [
        sh:class mkt:MarketClaim ;
        sh:path vzro:contradicts
      ], [
        sh:class mkt:MarketClaim ;
        sh:path vzro:supersedes
      ], [
        sh:minCount 1 ;
        sh:path obo:IAO_0000136
      ] ;
  sh:targetClass mkt:MarketClaim .

mkt:MarketEventShape
  a sh:NodeShape ;
  sh:property [
        sh:class loc:Location ;
        sh:path drm:occursIn
      ], [
        sh:class party:Party ;
        sh:path obo:RO_0000057
      ] ;
  sh:targetClass mkt:MarketEvent .

mkt:MarketRoleShape
  a sh:NodeShape ;
  rdfs:comment "A market role is borne by a party (RO role of)."@en ;
  sh:property [
        sh:class party:Party ;
        sh:minCount 1 ;
        sh:path obo:RO_0000081
      ] ;
  sh:targetClass mkt:MarketRole .

mkt:MarketSegmentDefinitionShape
  a sh:NodeShape ;
  sh:property [
        sh:class mkt:MarketSegment ;
        sh:minCount 1 ;
        sh:path obo:IAO_0000136
      ] ;
  sh:targetClass mkt:MarketSegmentDefinition .

mkt:MarketSegmentShape
  a sh:NodeShape ;
  sh:property [
        sh:class party:Party ;
        sh:path obo:RO_0002351
      ] ;
  sh:targetClass mkt:MarketSegment .

mkt:MarketingCapabilityShape
  a sh:NodeShape ;
  rdfs:comment "Polymorphism pivot: the Marketing capability is realized in Marketing processes."@en ;
  sh:property [
        sh:class mkt:Marketing ;
        sh:path obo:BFO_0000054
      ] ;
  sh:targetClass mkt:MarketingCapability .

