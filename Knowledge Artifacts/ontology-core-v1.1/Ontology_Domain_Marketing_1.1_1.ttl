      ] ;
  sh:targetClass mkt:MarketingCommunicationsService .

mkt:MarketingComplianceReviewCapabilityShape
  a sh:NodeShape ;
  rdfs:comment "Polymorphism pivot: the Marketing Compliance Review capability is realized in Marketing Compliance Review processes."@en ;
  sh:property [
        sh:class mkt:MarketingComplianceReview ;
        sh:path obo:BFO_0000054
      ] ;
  sh:targetClass mkt:MarketingComplianceReviewCapability .

mkt:MarketingComplianceReviewServiceShape
  a sh:NodeShape ;
  rdfs:comment "Polymorphism pivot: the Marketing Compliance Review service enables the Marketing Compliance Review capability."@en ;
  sh:property [
        sh:class mkt:MarketingComplianceReviewCapability ;
        sh:path drm:enables
      ] ;
  sh:targetClass mkt:MarketingComplianceReviewService .

mkt:MarketingComplianceRuleShape
  a sh:NodeShape ;
  sh:property [
        sh:class mkt:Marketing ;
        sh:path drm:constrains
      ] ;
  sh:targetClass mkt:MarketingComplianceRule .

mkt:MarketingContentShape
  a sh:NodeShape ;
  sh:property [
        sh:class mkt:MarketingChannel ;
        sh:path vzro:distributedThrough
      ], [
        sh:or ( [
              sh:class mkt:MarketSegment
            ] [
              sh:class persona:Persona
            ] ) ;
        sh:path vzro:targets
      ], [
        sh:or ( [
              sh:class mkt:Offering
            ] [
              sh:class mkt:BrandAsset
            ] ) ;
        sh:path vzro:promotes
      ] ;
  sh:targetClass mkt:MarketingContent .

mkt:MarketingDecisionRecordShape
  a sh:NodeShape ;
  rdfs:comment "A decision records the insights behind it and commits to outcomes."@en ;
  sh:property [
        sh:class mkt:MarketingInsight ;
        sh:path vzro:informedBy
      ], [
        sh:class mkt:MarketingOutcome ;
        sh:path drm:has
      ] ;
  sh:targetClass mkt:MarketingDecisionRecord .

mkt:MarketingInsightShape
  a sh:NodeShape ;
  sh:property [
        sh:or ( [
              sh:class mkt:MarketingDecisionRecord
            ] [
              sh:class mkt:Marketing
            ] [
              sh:class mkt:MarketingPlanSpecification
            ] ) ;
        sh:path vzro:informs
      ] ;
  sh:targetClass mkt:MarketingInsight .

mkt:MarketingInsightsAnalysisCapabilityShape
  a sh:NodeShape ;
  rdfs:comment "Polymorphism pivot: the Marketing Insights & Analysis capability is realized in Marketing Insights & Analysis processes."@en ;
  sh:property [
        sh:class mkt:MarketingInsightsAnalysis ;
        sh:path obo:BFO_0000054
      ] ;
  sh:targetClass mkt:MarketingInsightsAnalysisCapability .

mkt:MarketingInsightsAnalysisServiceShape
  a sh:NodeShape ;
  rdfs:comment "Polymorphism pivot: the Marketing Insights & Analysis service enables the Marketing Insights & Analysis capability."@en ;
  sh:property [
        sh:class mkt:MarketingInsightsAnalysisCapability ;
        sh:path drm:enables
      ] ;
  sh:targetClass mkt:MarketingInsightsAnalysisService .

mkt:MarketingManagementCapabilityShape
  a sh:NodeShape ;
  rdfs:comment "Polymorphism pivot: the Marketing Management capability is realized in Marketing Management processes."@en ;
  sh:property [
        sh:class mkt:MarketingManagement ;
        sh:path obo:BFO_0000054
      ] ;
  sh:targetClass mkt:MarketingManagementCapability .

mkt:MarketingManagementOutputShape
  a sh:NodeShape ;
  sh:property [
        sh:class mkt:MarketingPlanSpecification ;
        sh:path drm:creates
      ] ;
  sh:targetClass mkt:MarketingManagement .

mkt:MarketingManagementServiceShape
  a sh:NodeShape ;
  rdfs:comment "Polymorphism pivot: the Marketing Management service enables the Marketing Management capability."@en ;
  sh:property [
        sh:class mkt:MarketingManagementCapability ;
        sh:path drm:enables
      ] ;
  sh:targetClass mkt:MarketingManagementService .

mkt:MarketingManagementShape
  a sh:NodeShape ;
  sh:property [
        sh:class vs:MarketingBrandManagement ;
        sh:path drm:enables
      ] ;
  sh:targetClass mkt:MarketingManagement .

mkt:MarketingMeasurementShape
  a sh:NodeShape ;
  sh:property [
        sh:class mkt:MarketingMetric ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:path drm:typeOf
      ], [
        sh:minCount 1 ;
        sh:or ( [
              sh:class mkt:MarketingCharacteristic
            ] [
              sh:class mkt:MarketingOutcome
            ] [
              sh:class mkt:Marketing
            ] ) ;
        sh:path vzro:measures
      ] ;
  sh:targetClass mkt:MarketingMeasurement .

mkt:MarketingMixCapabilityShape
  a sh:NodeShape ;
  rdfs:comment "Polymorphism pivot: the Marketing Mix capability is realized in Marketing Mix processes."@en ;
  sh:property [
        sh:class mkt:MarketingMix ;
        sh:path obo:BFO_0000054
      ] ;
  sh:targetClass mkt:MarketingMixCapability .

mkt:MarketingMixServiceShape
  a sh:NodeShape ;
  rdfs:comment "Polymorphism pivot: the Marketing Mix service enables the Marketing Mix capability."@en ;
  sh:property [
        sh:class mkt:MarketingMixCapability ;
        sh:path drm:enables
      ] ;
  sh:targetClass mkt:MarketingMixService .

mkt:MarketingOutcomeShape
  a sh:NodeShape ;
  rdfs:comment "Every committed outcome is bound to a released metric definition."@en ;
  sh:property [
        sh:class mkt:MarketingMetric ;
        sh:minCount 1 ;
        sh:path vzro:measuredBy
      ] ;
  sh:targetClass mkt:MarketingOutcome .

mkt:MarketingServiceShape
  a sh:NodeShape ;
  rdfs:comment "Polymorphism pivot: the Marketing service enables the Marketing capability."@en ;
  sh:property [
        sh:class mkt:MarketingCapability ;
        sh:path drm:enables
      ] ;
  sh:targetClass mkt:MarketingService .

mkt:MarketingShape
  a sh:NodeShape ;
  rdfs:comment "Marketing processes create marketing assets, target segments or personas and promote offerings or brands."@en ;
  sh:property [
        sh:class mkt:MarketingAsset ;
        sh:path drm:creates
      ], [
        sh:or ( [
              sh:class mkt:MarketSegment
            ] [
              sh:class persona:Persona
            ] [
              sh:class party:Party
            ] ) ;
        sh:path vzro:targets
      ], [
        sh:or ( [
              sh:class mkt:Offering
            ] [
              sh:class mkt:BrandAsset
            ] ) ;
        sh:path vzro:promotes
      ] ;
  sh:targetClass mkt:Marketing .

mkt:OfferingShape
  a sh:NodeShape ;
  sh:property [
        sh:class mkt:MarketSegment ;
        sh:path vzro:targets
      ], [
        sh:class mkt:MarketingChannel ;
        sh:path vzro:distributedThrough
      ], [
        sh:class mkt:Offering ;
        sh:path vzro:competesWith
      ], [
        sh:class mkt:OfferingFeature ;
        sh:path obo:BFO_0000051
      ], [
        sh:class mkt:PricingModel ;
        sh:path vzro:hasPricingModel
      ], [
        sh:class svc:Services ;
        sh:path obo:IAO_0000136
      ] ;
  sh:targetClass mkt:Offering .

mkt:OpeningAssessmentShape
  a sh:NodeShape ;
  sh:property [
        sh:class mkt:IntelligenceSource ;
        sh:minCount 1 ;
        sh:path vzro:evidencedBy
      ], [
        sh:minCount 1 ;
        sh:path obo:IAO_0000136
      ] ;
  sh:targetClass mkt:OpeningAssessment .

mkt:PerformanceMarketingCapabilityShape
  a sh:NodeShape ;
  rdfs:comment "Polymorphism pivot: the Performance Marketing capability is realized in Performance Marketing processes."@en ;
  sh:property [
        sh:class mkt:PerformanceMarketing ;
        sh:path obo:BFO_0000054
      ] ;
  sh:targetClass mkt:PerformanceMarketingCapability .

mkt:PerformanceMarketingServiceShape
  a sh:NodeShape ;
  rdfs:comment "Polymorphism pivot: the Performance Marketing service enables the Performance Marketing capability."@en ;
  sh:property [
        sh:class mkt:PerformanceMarketingCapability ;
        sh:path drm:enables
      ] ;
  sh:targetClass mkt:PerformanceMarketingService .

mkt:ProductManagementShape
  a sh:NodeShape ;
  rdfs:comment "Replaces the 1.0 axiom that made Product Catalog a subclass of Product Management: the process modifies the catalog."@en ;
  sh:property [
        sh:class prod:ProductCatalog ;
        sh:path drm:modifies
      ] ;
  sh:targetClass mkt:ProductManagement .

mkt:ProductMarketingCapabilityShape
  a sh:NodeShape ;
  rdfs:comment "Polymorphism pivot: the Product Marketing capability is realized in Product Marketing processes."@en ;
  sh:property [
        sh:class mkt:ProductMarketing ;
        sh:path obo:BFO_0000054
      ] ;
  sh:targetClass mkt:ProductMarketingCapability .

mkt:ProductMarketingServiceShape
  a sh:NodeShape ;
  rdfs:comment "Polymorphism pivot: the Product Marketing service enables the Product Marketing capability."@en ;
  sh:property [
        sh:class mkt:ProductMarketingCapability ;
        sh:path drm:enables
      ] ;
  sh:targetClass mkt:ProductMarketingService .

mkt:ThreatAssessmentShape
  a sh:NodeShape ;
  sh:property [
        sh:class mkt:IntelligenceSource ;
        sh:minCount 1 ;
        sh:path vzro:evidencedBy
      ], [
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:maxInclusive 3 ;
        sh:minCount 1 ;
        sh:minInclusive 1 ;
        sh:path mkt:severityScore
      ], [
        sh:minCount 1 ;
        sh:path obo:IAO_0000136
      ] ;
  sh:targetClass mkt:ThreatAssessment .

mkt:ThreatensShape
  a sh:NodeShape ;
  rdfs:comment "What can be threatened: one of the organization's capabilities, segment positions, positioning claims or offerings."@en ;
  sh:property [
        sh:or ( [
              sh:class cap:Capability
            ] [
              sh:class mkt:MarketSegment
            ] [
              sh:class mkt:PositioningClaim
            ] [
              sh:class mkt:Offering
            ] ) ;
        sh:path vzro:threatens
      ] ;
  sh:targetSubjectsOf vzro:threatens .

mkt:WinLossRecordShape
  a sh:NodeShape ;
  sh:property [
        sh:class mkt:MarketEvent ;
        sh:minCount 1 ;
        sh:path obo:IAO_0000136
      ], [
        sh:class mkt:WinLossReason ;
        sh:minCount 1 ;
        sh:path drm:has
      ] ;
  sh:targetClass mkt:WinLossRecord .
