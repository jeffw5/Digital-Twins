  a skos:Concept;
  skos:definition "The process of translating between different identity formats."@en;
  skos:prefLabel "Identity Mediation"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-technicalservices> .

<https://vocabularies.verizon.com/core-technicalservices/a61ef64d-e4e8-4ea3-84b2-f47509dd57e0>
  a skos:Concept;
  skos:definition "Specialized support for technical products or services, often requiring advanced technical expertise."@en;
  skos:prefLabel "Technical Services"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-technicalservices> .

<https://vocabularies.verizon.com/core-technicalservices/53f243a0-ef43-4965-8b76-662bf0c8b1bb>
  a skos:Concept;
  skos:definition "The process of managing and securing digital identities within an organization, encompassing the identification, authentication, and authorization of users and devices to access resources and systems. "@en;
  skos:prefLabel "Identity Management"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-technicalservices> .

<https://vocabularies.verizon.com/core-technicalservices/9bd16586-4f37-48eb-b0ce-3211a90cb34d>
  a skos:Concept;
  skos:definition "A comprehensive process that encompasses identifying, assessing, and responding to potential threats, using various strategies and techniques to mitigate risks and protect organizations or individuals. "@en;
  skos:prefLabel "Threat Management"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-technicalservices> .

<https://vocabularies.verizon.com/core-technicalservices/fd397e18-0879-4145-a16d-4ae4ecc7e1b3>
  a skos:Concept;
  skos:definition "The process of managing and assigning tokens, which are used to authenticate users and authorize access to resources."@en;
  skos:prefLabel "Token Assignment"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-technicalservices> .

<https://vocabularies.verizon.com/core-technicalservices/d5a5b4eb-7344-485e-90be-8a33391524a8>
  a skos:Concept;
  skos:definition "A restriction placed on one or more temporal data items, which represent time points or time periods"@en;
  skos:prefLabel "Temporal Constraint Timer"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-technicalservices> .

<https://vocabularies.verizon.com/core-technicalservices/d6f8830b-389a-447c-872d-ff567b56fe24>
  a skos:Concept;
  skos:definition "A detailed analysis of detected threats to understand their nature, origin, potential impact, and to develop an effective incident response plan, including identifying and containing the incident, mitigating damage, and recovering compromised systems. "@en;
  skos:prefLabel "Investigation"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-technicalservices> .

<https://vocabularies.verizon.com/core-technicalservices/e0745264-eb8a-418c-9b32-19343acbeaa3>
  a skos:Concept;
  skos:definition "The proactive strategies and actions taken to reduce or minimize the potential impact of threats and vulnerabilities. It involves identifying risks, implementing protective measures, and continuously monitoring for threats to prevent security breaches. "@en;
  skos:prefLabel "Mitigation"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-technicalservices> .

<https://vocabularies.verizon.com/core-technicalservices/4da76f53-8a1c-42d0-9394-12b94cf35e7c>
  a skos:Concept;
  skos:definition "A proactive security measure that enables organizations to detect, identify, and respond to potential security incidents in an increasingly sophisticated and pervasive era."@en;
  skos:prefLabel "Monitoring"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-technicalservices> .

<https://vocabularies.verizon.com/core-technicalservices/0c861202-1e1b-4121-8861-7a5e1d19f336>
  a skos:Concept;
  skos:definition "Proactive measures and strategies implemented to block or deter threats from reaching or damaging systems, networks, or data before they can cause harm. "@en;
  skos:prefLabel "Prevention"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-technicalservices> .

<https://vocabularies.verizon.com/core-technicalservices/8d715475-bc5f-4304-8b53-b58a34c073d7>
  a skos:Concept;
  skos:definition "Equipping individuals with the knowledge, skills, and awareness necessary to identify, assess, and respond to potential threats, ultimately enhancing an organization's ability to mitigate risks. "@en;
  skos:prefLabel "Training"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-technicalservices> .

