  dct:creator "milsh69";
  dct:modified "2025-04-01T17:25:32.185Z"^^xsd:dateTime;
  dct:created "2025-03-31T18:44:16.026Z"^^xsd:dateTime .

<https://vocabularies.verizon.com/core-issue/7b06ba32-215a-45ee-90eb-e8ded38777dd>
  a skos:Concept;
  skos:definition "High-level requirements or expectations that must be met for a product or system to be successful."@en;
  skos:prefLabel "Needs"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-issue/>;
  skos:broader <https://vocabularies.verizon.com/core-issue/e9cee37a-9a70-43d7-a1d6-2a125bddae63>;
