  dct:created "2025-03-31T18:44:16.026Z"^^xsd:dateTime .

<https://vocabularies.verizon.com/core-issue/59bff6f8-1846-4afc-9d2a-15e8254e3b82>
  a skos:Concept;
  skos:definition "A situation or event that needs to be investigated and resolved. It may be a symptom of a defect, an unexpected behavior, or a performance issue."@en;
  skos:prefLabel "Problem"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-issue/>;
  skos:broader <https://vocabularies.verizon.com/core-issue/3d2e49bb-6acf-4101-af41-46b31cfe6a7a>;
