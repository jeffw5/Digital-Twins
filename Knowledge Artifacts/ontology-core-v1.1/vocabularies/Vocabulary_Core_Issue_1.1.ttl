<https://vocabularies.verizon.com/core-issue/3d2e49bb-6acf-4101-af41-46b31cfe6a7a>
  a skos:Concept;
  skos:definition "A generic term used to describe any problem, concern, or question that needs to be addressed. It is a broad term that encompasses defects, incidents, problems, requests, needs, and questions."@en;
  skos:prefLabel "Issue"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-issue/>;
  <http://open-services.net/ns/core#modifiedBy> "milsh69";
  dct:contributor "milsh69";
  dct:creator "milsh69";
  dct:modified "2025-04-14T14:08:33.781Z"^^xsd:dateTime;
  dct:created "2025-03-25T17:19:17.993Z"^^xsd:dateTime .

<https://vocabularies.verizon.com/core-issue/86d58597-5a5c-47e6-ac8e-381b4bbd36bf>
  a skos:Concept;
  skos:definition "A flaw or imperfection in a product or system that causes it to deviate from its intended behavior or specifications. This deviation may or may not impact usability."@en;
  skos:prefLabel "Defect"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-issue/>;
  skos:broader <https://vocabularies.verizon.com/core-issue/3d2e49bb-6acf-4101-af41-46b31cfe6a7a>;
  <http://open-services.net/ns/core#modifiedBy> "milsh69";
  dct:contributor "milsh69";
  dct:creator "milsh69";
  dct:modified "2025-04-01T17:24:51.118Z"^^xsd:dateTime;
  dct:created "2025-03-31T18:44:16.026Z"^^xsd:dateTime .

<https://vocabularies.verizon.com/core-issue/65c8c83a-f4b6-4f7e-8a70-0cda08962bb6>
  a skos:Concept;
  skos:definition "An event that disrupts or could disrupt a service or system operation. Often used interchangeably with “problem”."@en;
  skos:prefLabel "Incident"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-issue/>;
  skos:broader <https://vocabularies.verizon.com/core-issue/59bff6f8-1846-4afc-9d2a-15e8254e3b82>;
  <http://open-services.net/ns/core#modifiedBy> "milsh69";
  dct:contributor "milsh69";
  dct:creator "milsh69";
  dct:modified "2025-04-01T17:25:44.864Z"^^xsd:dateTime;
  dct:created "2025-03-31T18:44:16.026Z"^^xsd:dateTime .

<https://vocabularies.verizon.com/core-issue/2238f3ea-708b-4d0a-a6fe-0393f3c74f15>
  a skos:Concept;
  skos:definition "A significant defect that severely impacts the functionality, performance, or usability of a product or system. It may render the product unusable or cause a critical loss of data or functionality."@en;
  skos:prefLabel "Major Defect"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-issue/>;
  skos:broader <https://vocabularies.verizon.com/core-issue/86d58597-5a5c-47e6-ac8e-381b4bbd36bf>;
  <http://open-services.net/ns/core#modifiedBy> "milsh69";
  dct:contributor "milsh69";
  dct:creator "milsh69";
  dct:modified "2025-04-01T17:25:21.380Z"^^xsd:dateTime;
  dct:created "2025-03-31T18:44:16.026Z"^^xsd:dateTime .

<https://vocabularies.verizon.com/core-issue/53763e91-fe23-4609-b179-13bfaa87c5ef>
  a skos:Concept;
  skos:definition "A small, insignificant flaw that does not significantly impact the functionality or usability of a product or system. It may be a cosmetic issue or a slight deviation from the specifications."@en;
  skos:prefLabel "Minor Defect"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-issue/>;
  skos:broader <https://vocabularies.verizon.com/core-issue/86d58597-5a5c-47e6-ac8e-381b4bbd36bf>;
  <http://open-services.net/ns/core#modifiedBy> "milsh69";
