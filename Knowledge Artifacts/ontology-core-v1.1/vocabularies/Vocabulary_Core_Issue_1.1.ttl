  dct:created "2025-03-31T18:44:16.026Z"^^xsd:dateTime .

<https://vocabularies.verizon.com/core-issue/07e3e717-6ff3-4e02-8bac-ffeea6257ad5>
  a skos:Concept;
  skos:definition "An inquiry seeking information or clarification on a particular topic or issue."@en;
  skos:prefLabel "Question"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-issue/>;
  skos:broader <https://vocabularies.verizon.com/core-issue/e9cee37a-9a70-43d7-a1d6-2a125bddae63>;
