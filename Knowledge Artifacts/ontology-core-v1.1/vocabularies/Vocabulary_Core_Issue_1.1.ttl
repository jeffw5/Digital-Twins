<https://vocabularies.verizon.com/core-issue/e9cee37a-9a70-43d7-a1d6-2a125bddae63>
  a skos:Concept;
  skos:definition "A formal demand for something, such as a change, enhancement, or new feature."@en;
  skos:prefLabel "Request"@en;
  skos:inScheme <https://vocabularies.verizon.com/core-issue/>;
