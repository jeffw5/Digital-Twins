mktx:
  a owl:Ontology ;
  <http://purl.org/ontology/bibo/status> <http://purl.org/spar/pso/draft> ;
  <http://verizon.ontologies.com/terms/certified> false ;
  <http://www.linkedmodel.org/1.2/schema/vaem#namespace> "https://ontologies.verizon.com/taxonomy-domain-marketing/"^^xsd:anyURI ;
  dct:contributor "wallkje" ;
  dct:created "2026-10-05T17:00:00.000Z"^^xsd:dateTime ;
  dct:creator "Jeffrey Wallk" ;
  dct:description "Structures for the marketing domain: the specialisations of the roots declared in ontology-domain-marketing, covering market roles, segments, PEO offerings and features, pricing models, channels, content formats, plans, market events and competitive moves, intelligence sources by authority tier, claim types and verdicts, intelligence products, win/loss reasons, metrics, customer dispositions, lifecycle stages, compliance rules, intelligence policies and issues."@en ;
  dct:modified "2026-10-05T17:00:00.000Z"^^xsd:dateTime ;
  dct:title "Taxonomy | Domain | Marketing"@en ;
  oslc:modifiedBy "wallkje" ;
  owl:imports mkt: ;
  owl:versionIRI <https://ontologies.verizon.com/taxonomy-domain-marketing/1.0> ;
  owl:versionInfo "1.0" ;
  rdfs:label "Taxonomy | Domain | Marketing"@en ;
  skos:changeNote "1.0: initial version."@en ;
  skos:editorialNote "Every class specialises a root declared in ontology-domain-marketing and so inherits its BFO anchor and shapes. Signal classes are defined by the market event they are about and share that event's vocabulary concept, so a reasoner classifies signals automatically."@en .

